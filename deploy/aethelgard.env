# Project Aethelgard Configuration
# Path: /etc/default/aethelgard

# Local port to bind the Netty transport server
PORT=8001

# Optional peer bootstrap address to connect to (e.g., --connect=192.168.1.10:8001)
# Leave empty if this node is the bootstrap root.
EXTRA_ARGS=""

# Examples of EXTRA_ARGS:
# EXTRA_ARGS="--connect=10.0.0.1:8001"
# EXTRA_ARGS="--connect=10.0.0.1:8001 --node-id=edge-node-01"
